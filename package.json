{
  "name": "deepseek-web-search-mcp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server for DeepSeek native web search and research plus AnySearch, Tavily, and self-hosted SearXNG fallback.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp": "npm run build --silent && node scripts/mcp-smoke.mjs",
    "start": "node dist/index.js",
    "doctor": "npm run build --silent && node dist/index.js --doctor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tavily/core": "0.7.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
