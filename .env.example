# Copy these variables into your process environment or Windows user environment.
# Empty values are treated as unset; API keys are only read from the environment.

DEEPSEEK_API_KEY=
WEB_SEARCH_BACKEND=hybrid
FAST_CLEANING_MODE=shadow
FAST_DOMAIN_CAP=2
DOCUMENTATION_QUERY_MODE=fast
SOURCE_IDENTITY_MODE=on
SOURCE_IDENTITY_CROSS_HOST=on
SOURCE_IDENTITY_VERBOSE=off
FRESHNESS_INTENT_WARNING=on
RESEARCH_SESSION_TTL_MS=1800000
RESEARCH_SESSION_MAX_SESSIONS=100
RESEARCH_SESSION_MAX_TURNS=8

# DeepSeek official Search API (web_search backends deepseek-search and hybrid).
# Base URL only; the provider appends /tools/search.
DEEPSEEK_SEARCH_API_BASE_URL=https://api.deepseek.com/v1
# Search API request timeout in milliseconds.
DEEPSEEK_SEARCH_API_TIMEOUT_MS=15000
# on = request page content from the Search API (larger responses, same price per request);
# off = omit content.
DEEPSEEK_SEARCH_NEED_CONTENT=off

# DeepSeek Anthropic-compatible Messages API base, used by web_research and by
# web_search backend=deepseek-native (legacy). The Anthropic SDK appends /v1/messages.
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_SEARCH_MODEL=deepseek-flash
DEEPSEEK_SEARCH_MAX_USES=5
DEEPSEEK_SEARCH_MAX_TOKENS=4096

ANYSEARCH_API_KEY=
ANYSEARCH_MCP_URL=https://api.anysearch.com/mcp

TAVILY_API_KEY=

# --- OpenRouter models (v1.7.0; optional, skipped when the key is empty) ---
OPENROUTER_API_KEY=

# Shared OpenRouter client limits for rerank, decisions and embeddings.
OPENROUTER_MAX_CALLS_PER_MINUTE=30
OPENROUTER_MAX_CONCURRENCY=2

# Rerank (balanced/deep). Base default is the 3.5 8b model; balanced uses the
# lower-latency 1b-v2 model; deep inherits the base model.
OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
OPENROUTER_RERANK_MODEL_BALANCED=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Empty = deep inherits OPENROUTER_RERANK_MODEL.
OPENROUTER_RERANK_MODEL_DEEP=
# Optional; retried once only when the primary model returns HTTP 404.
OPENROUTER_RERANK_FALLBACK_MODEL=
# Empty/0 = per-model profile timeout (old 1b-v2 5000 ms, 3.5 12000 ms).
OPENROUTER_RERANK_TIMEOUT_MS=
# auto = minmax for the 3.5 family, raw for the old 1b-v2 and unknown models.
RERANK_NORMALIZATION=auto
RERANK_CONFIDENCE_FLOOR=0.35
RERANK_TOP1_MIN=0.85
# RERANK_CANDIDATE_LIMIT is clamped to at most 30.
RERANK_CANDIDATE_LIMIT=30
RERANK_INPUT_CHARS=800

# docs-intent veto (balanced/deep only; opt-in; default off).
# The decisions model is web-grounded: it performs its own search and returns
# citations, so enabling it adds a distinct external egress for the raw query.
WEB_SEARCH_DECISIONS_MODE=off
# Alias kept for compatibility; WEB_SEARCH_DECISIONS_MODE wins when both are set.
# DECISIONS_MODE=off
OPENROUTER_DECISIONS_MODEL=parallel/decisions-fast:free
# Report-only metadata; the verdict uses the fixed 0.25/0.40 dead band.
OPENROUTER_DECISIONS_THRESHOLD=0.30
# 4s default: cold-start calls can take 1-2.5s; a 2.5s cap caused false fallbacks.
OPENROUTER_DECISIONS_TIMEOUT_MS=4000
OPENROUTER_DECISIONS_CACHE_TTL_MS=86400000
OPENROUTER_DECISIONS_CACHE_MAX_ENTRIES=500
# Local per-minute budget on top of the shared OpenRouter limit.
WEB_SEARCH_DECISIONS_MAX_CALLS_PER_MINUTE=4
WEB_SEARCH_DECISIONS_CIRCUIT_COOLDOWN_MS=300000

# Semantic syndication dedupe (balanced/deep only; default off).
# off | shadow | on. The 8b endpoint is unreliable (deterministic 502 for n>=3),
# so keep this off unless you accept the fallbacks; shadow/on add up to ~6s.
EMBEDDING_MODE=off
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
# Fallback chain: free vl-1b model -> paid baai/bge-m3 -> lexical dedupe.
EMBEDDING_FALLBACK_MODELS=nvidia/llama-nemotron-embed-vl-1b-v2:free,baai/bge-m3
EMBEDDING_MAX_PAIRS=8
EMBEDDING_BUDGET_MS=6000
# Empty = per-model profile threshold (0.62 / 0.62 / 0.72).
EMBEDDING_DEDUPE_THRESHOLD=
EMBEDDING_CACHE_TTL_MS=3600000
EMBEDDING_CACHE_MAX_ENTRIES=300
EMBEDDING_CIRCUIT_FAILURES=5
EMBEDDING_CIRCUIT_COOLDOWN_MS=120000

SEARCH_CACHE_TTL_MS=600000
SEARCH_CACHE_MAX_ENTRIES=200
RERANK_CACHE_TTL_MS=1800000
RERANK_CACHE_MAX_ENTRIES=200

SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_LANGUAGE=zh-CN

# Legacy Messages path only.
DEEPSEEK_SEARCH_TIMEOUT_MS=150000
ANYSEARCH_TIMEOUT_MS=6000
TAVILY_TIMEOUT_MS=6000
SEARXNG_TIMEOUT_MS=10000
