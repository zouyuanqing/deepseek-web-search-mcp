# Copy these variables into your process environment or Windows user environment.
# Empty values are treated as unset; API keys are only read from the environment.

DEEPSEEK_API_KEY=
WEB_SEARCH_BACKEND=hybrid
FAST_CLEANING_MODE=shadow
FAST_DOMAIN_CAP=2
DOCUMENTATION_QUERY_MODE=fast
SOURCE_IDENTITY_MODE=on
SOURCE_IDENTITY_CROSS_HOST=on
SOURCE_IDENTITY_VERBOSE=off
FRESHNESS_INTENT_WARNING=on
RESEARCH_SESSION_TTL_MS=1800000
RESEARCH_SESSION_MAX_SESSIONS=100
RESEARCH_SESSION_MAX_TURNS=8

# DeepSeek official Search API (web_search backends deepseek-search and hybrid).
# Base URL only; the provider appends /tools/search.
DEEPSEEK_SEARCH_API_BASE_URL=https://api.deepseek.com/v1
# Search API request timeout in milliseconds.
DEEPSEEK_SEARCH_API_TIMEOUT_MS=15000
# on = request page content from the Search API (larger responses, same price per request);
# off = omit content.
DEEPSEEK_SEARCH_NEED_CONTENT=off

# DeepSeek Anthropic-compatible Messages API base, used by web_research and by
# web_search backend=deepseek-native (legacy). The Anthropic SDK appends /v1/messages.
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_SEARCH_MODEL=deepseek-flash
DEEPSEEK_SEARCH_MAX_USES=5
DEEPSEEK_SEARCH_MAX_TOKENS=4096

ANYSEARCH_API_KEY=
ANYSEARCH_MCP_URL=https://api.anysearch.com/mcp

TAVILY_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
OPENROUTER_RERANK_TIMEOUT_MS=5000
RERANK_CANDIDATE_LIMIT=30
RERANK_INPUT_CHARS=800
SEARCH_CACHE_TTL_MS=600000
SEARCH_CACHE_MAX_ENTRIES=200
RERANK_CACHE_TTL_MS=1800000
RERANK_CACHE_MAX_ENTRIES=200

SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_LANGUAGE=zh-CN

# Legacy Messages path only.
DEEPSEEK_SEARCH_TIMEOUT_MS=150000
ANYSEARCH_TIMEOUT_MS=6000
TAVILY_TIMEOUT_MS=6000
SEARXNG_TIMEOUT_MS=10000
